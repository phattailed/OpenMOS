# Normalize line endings so the repo stays LF in Git regardless of OS.
# Prevents spurious whole-file diffs when committing from Windows.
* text=auto eol=lf

# Windows-only scripts keep CRLF locally.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets: never touch line endings.
*.jpg binary
*.png binary
*.gif binary
*.7z binary
*.zip binary
*.exe binary
*.dtd text
*.xsd text
